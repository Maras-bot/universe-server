# Copia in .env e riempi i valori. Non committare .env e non mettere token qui.
# Lascia UNIVERSE_ALLOW_LIVE non impostata. Il live deve restare spento finché
# Maras non dà un ok esplicito, con il gate di conferma già attivo.

UNIVERSE_DRY_RUN=1
UNIVERSE_ENABLE_DOCS=0
UNIVERSE_REQUIRE_TLS=1
UNIVERSE_MAX_REQUEST_BYTES=65536
UNIVERSE_HTTP_RATE_LIMIT_PER_MINUTE=60
UNIVERSE_HTTP_RATE_LIMIT_UNAUTH_PER_MINUTE=20
UNIVERSE_CONFIGS_DIR=configs
UNIVERSE_AUDIT_PATH=logs/audit.jsonl
UNIVERSE_CONFIRMATION_TIMEOUT_SECONDS=60

# File 0600 con {"bots": {"test-client": "..."}, "phone": "..."}.
# In produzione usa il secret store della piattaforma (es. variabili Railway).
UNIVERSE_BOT_TOKENS_FILE=/run/secrets/universe-tokens.json

# Alternativa sconsigliata (il valore finisce nell'ambiente del processo):
# UNIVERSE_BOT_TOKENS={"test-client":"metti-un-token-lungo-casuale-qui"}
# UNIVERSE_PHONE_TOKEN=metti-un-token-lungo-diverso-qui

# Non impostare UNIVERSE_ALLOW_LIVE.
# Porta usata da Railway / dal processo. Dietro TLS all'edge.
PORT=8080
